# ---------------------------------------------------------------------------
# MEPro API - environment configuration
#
# Copy to `.env` and adjust. `.env` is git-ignored; this file is the contract.
# The app validates everything through Zod at boot (src/config/env.ts) and
# refuses to start on missing or placeholder secrets in production.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development
PORT=5000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/mepro
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/mepro?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/mepro

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Access and refresh tokens MUST use different secrets.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-16-chars

# jsonwebtoken duration strings.
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Comma-separated list of allowed browser origins.
CLIENT_URL=http://localhost:8081,http://localhost:19006

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# Relative paths resolve against the project root. Served at /uploads.
UPLOAD_DIR=uploads

# ---------------------------------------------------------------------------
# AI (Transformers.js, fully local - no API keys, no paid services)
# ---------------------------------------------------------------------------
# Master switch. When false, or when a model fails to load, every feature falls
# back to the deterministic rule engine in src/services/ai/fallback.service.ts.
AI_ENABLED=true

# Intent/topic classifier used by the assistant and recommendation explainer.
# Small enough to run on CPU.
AI_MODEL=Xenova/nli-deberta-v3-xsmall

# Sentence embedder used for semantic ranking and similarity.
AI_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Optional instruction-tuned generator. Left empty on purpose: the assistant
# answers from the user's own data through templates, which is grounded and
# instant. Set a model id here to enable free-form generation.
AI_GENERATION_MODEL=
AI_GENERATION_ENABLED=false

# Hard ceiling for a single inference call before the fallback takes over.
AI_TIMEOUT_MS=20000

# onnxruntime download/cache directory (kept out of the repo).
AI_CACHE_DIR=.cache/models

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=30

# silent | error | warn | info | debug
LOG_LEVEL=info
